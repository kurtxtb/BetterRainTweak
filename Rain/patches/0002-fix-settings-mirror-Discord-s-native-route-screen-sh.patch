From 46c785d636b065a2a12388dffccb6f6072d36a6b Mon Sep 17 00:00:00 2001
From: kurtxtb <s0917077331@gmail.com>
Date: Sat, 10 Oct 2026 14:31:00 +0800
Subject: [PATCH 2/2] fix(settings): mirror Discord's native route screen shape

Discord 348 (iOS 113691) no longer renders screen.getComponent for
custom SETTING_RENDERER_CONFIG routes, so every Rain page crashed with
"Element type is invalid ... got: undefined".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/plugins/_core/settings/patches/shared.tsx |  4 +-
 src/plugins/_core/settings/patches/tabs.tsx   | 44 +++++++++++++++++--
 2 files changed, 42 insertions(+), 6 deletions(-)

diff --git a/src/plugins/_core/settings/patches/shared.tsx b/src/plugins/_core/settings/patches/shared.tsx
index 60c3807..5303725 100644
--- a/src/plugins/_core/settings/patches/shared.tsx
+++ b/src/plugins/_core/settings/patches/shared.tsx
@@ -9,11 +9,11 @@ export const CustomPageRenderer = React.memo(() => {
     const navigation = NavigationNative.useNavigation();
     const route = NavigationNative.useRoute();
 
-    const { render: PageComponent, ...args } = route.params;
+    const { render: PageComponent, ...args } = route.params ?? {};
 
     React.useEffect(() => void navigation.setOptions({ ...args }), []);
 
-    return <PageComponent />;
+    return PageComponent ? <PageComponent /> : null;
 });
 
 export function wrapOnPress(
diff --git a/src/plugins/_core/settings/patches/tabs.tsx b/src/plugins/_core/settings/patches/tabs.tsx
index 4ebab28..528e256 100644
--- a/src/plugins/_core/settings/patches/tabs.tsx
+++ b/src/plugins/_core/settings/patches/tabs.tsx
@@ -2,11 +2,50 @@ import { after } from "@api/patcher";
 import { useSettings } from "@api/settings";
 import { TableRow } from "@metro/common/components";
 import { findByPropsLazy } from "@metro/wrappers";
+import { logger } from "@lib/utils/logger";
 import React from "react";
 
 import { registeredSections } from "..";
 import { CustomPageRenderer, wrapOnPress } from "./shared";
 
+// Works as a component (<RainPageScreen />), as a getter (getComponent()) and as a
+// lazily imported module (getComponent().default), so the page renders no matter
+// which of these Discord's settings navigator expects.
+function RainPageScreen(props?: any): any {
+    if (props && typeof props === "object") return <CustomPageRenderer {...props} />;
+    return RainPageScreen;
+}
+(RainPageScreen as any).default = RainPageScreen;
+
+// Discord keeps renaming the fields of route entries in SETTING_RENDERER_CONFIG
+// (Discord 348 / iOS 113691 stopped rendering `screen.getComponent`, leaving an
+// `undefined` element). Mirror the shape of one of Discord's own route entries
+// instead of hardcoding it.
+function buildRainScreen(config: Record<string, any>) {
+    const screen: Record<string, any> = {
+        route: "RAIN_CUSTOM_PAGE",
+        getComponent: RainPageScreen,
+    };
+
+    const native = Object.values(config).find(
+        (v: any) => v?.type === "route" && v.screen && typeof v.screen === "object"
+    ) as any;
+    if (!native) return screen;
+
+    for (const [key, value] of Object.entries(native.screen)) {
+        // Only component-ish fields: others (options, title hooks...) keep their meaning.
+        if (typeof value === "function" && /comp|render|screen|page|view/i.test(key)) screen[key] = RainPageScreen;
+        else if (typeof value === "string" && value === native.screen.route) screen[key] = "RAIN_CUSTOM_PAGE";
+    }
+
+    if (!loggedShape) {
+        loggedShape = true;
+        logger.log("[settings] native route screen keys:", Object.keys(native.screen).join(", "));
+    }
+    return screen;
+}
+let loggedShape = false;
+
 const settingConstants = findByPropsLazy("SETTING_RENDERER_CONFIG");
 const createListModule = findByPropsLazy("createList");
 
@@ -38,10 +77,7 @@ export function patchTabsUI(unpatches: (() => void | boolean)[]) {
             RAIN_CUSTOM_PAGE: {
                 type: "route",
                 useTitle: () => "Rain",
-                screen: {
-                    route: "RAIN_CUSTOM_PAGE",
-                    getComponent: () => CustomPageRenderer
-                }
+                screen: buildRainScreen(rendererConfigValue)
             },
             ...getRows()
         }),
